# EduFocus server sozlamalari.
# Ishlatish:  cp config/.env.example config/.env   so'ng CHANGE_ME qiymatlarini to'ldiring.
# config/.env git'ga TUSHMAYDI. Muhit o'zgaruvchilari (process.env) bu fayldan ustun turadi.

# ---------- Umumiy ----------
NODE_ENV=development            # production'da JWT_SECRET majburiy
PORT=3000
DATA_DIR=                       # bo'sh = ./data
PUBLIC_BASE_URL=https://CHANGE_ME.example     # production URL (QR havolalari, maxfiylik sahifasi)

# ---------- Xavfsizlik ----------
JWT_SECRET=CHANGE_ME            # uzun tasodifiy satr:  openssl rand -hex 32
ENABLE_DEMO_TEACHER=false       # true = teacher@edufocus.uz / 123456 (faqat lokal ishlab chiqish!)
REGISTRATION_OPEN=true          # false = ustozlar faqat admin tomonidan qo'shiladi
ADMIN_BOOTSTRAP_EMAIL=          # birinchi admin (admin yo'q bo'lsa ishga tushganda yaratiladi)
ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME

# ---------- Maxfiylik siyosati egasi ----------
OWNER_COMPANY_NAME=CHANGE_ME
OWNER_EMAIL=CHANGE_ME
OWNER_STIR=CHANGE_ME
RETENTION_DAYS_AFTER_SEMESTER=90  # semestr tugagach shaxsiy ma'lumot saqlanish muddati (kun)

# ---------- Himoya darajalari (feature flag) ----------
# Apple entitlement kelgach true qiling (docs/store/apple-entitlements.md)
IOS_L1_ENABLED=false            # AEAssessmentSession
IOS_L2_ENABLED=false            # FamilyControls + ManagedSettings

# ---------- Attestatsiya ----------
# off | log (tekshiradi, rad etmaydi) | enforce (rad etadi) | mock (faqat testlar uchun)
ATTESTATION_MODE=log
APPLE_TEAM_ID=CHANGE_ME
APPLE_BUNDLE_ID=com.edufocus.app
APPLE_APP_ATTEST_ENV=production  # production | development
GOOGLE_PLAY_PACKAGE=com.edufocus.app
GOOGLE_SERVICE_ACCOUNT_PATH=     # Play Integrity uchun service account JSON yo'li
ANDROID_ALLOWED_CERT_SHA256=     # direct APK imzo sertifikati SHA-256 (vergul bilan ajrating)

# ---------- Push ----------
APNS_KEY_ID=CHANGE_ME
APNS_KEY_PATH=                   # .p8 fayl yo'li
FIREBASE_SERVICE_ACCOUNT_PATH=   # FCM uchun
VAPID_PUBLIC_KEY=                # ustoz paneli Web Push
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:CHANGE_ME

ACCESS_TOKEN_TTL=12h           # ustoz kirish tokeni (refresh token bilan yangilanadi)
REFRESH_TOKEN_DAYS=30
PUSH_MODE=real                  # real | off | mock (mock faqat testlar uchun)
APNS_TOPIC=com.edufocus.teacher # iOS ustoz ilovasi bundle ID
APNS_ENV=production             # production | development (TestFlight/App Store = production)
# ---------- Email (keyinroq; hozircha ishlatilmaydi) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---------- DEMO sessiya (do'kon tekshiruvchisi uchun) ----------
DEMO_ENABLED=true
DEMO_SESSION_CODE=123456
